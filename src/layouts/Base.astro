---
import '../styles/global.css';
import Letterhead from '../components/Letterhead.astro';
import LetterheadFoot from '../components/LetterheadFoot.astro';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  noindex?: boolean;
  /** Set true on the home page so it can opt out of the standard main padding. */
  bare?: boolean;
}
const {
  title,
  description = 'Behaviour-change science and complex systems for preparedness, health and well-being.',
  ogType = 'website',
  noindex = false,
  bare = false,
} = Astro.props;

// Cloudflare Web Analytics token is injected at deploy via env; blank locally.
const CF_ANALYTICS_TOKEN = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? '';

// Absolute URLs for social/share metadata. Astro.site is the canonical
// https://mattiheino.com, so these resolve correctly once the site is live there.
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Matti T.J. Heino" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Matti T.J. Heino" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="alternate" type="application/rss+xml" title="All writing" href="/all.xml" />
    <link rel="alternate" type="application/rss+xml" title="Writing" href="/posts.xml" />
    <link rel="alternate" type="application/rss+xml" title="Applied musings" href="/applied-musings.xml" />
    {
      CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </head>
  <body>
    <Letterhead />
    <main class={bare ? 'site-main site-main--bare' : 'site-main'}>
      <slot />
    </main>
    <LetterheadFoot />
  </body>
</html>
