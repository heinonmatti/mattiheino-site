---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { cleanSlug } from '../../lib/slug';

export async function getStaticPaths() {
  // Drafts stay out of the public build, but get a page on the local dev
  // server so a post can be previewed while still draft: true.
  const entries = await getCollection('posts', ({ data }) => !data.draft || import.meta.env.DEV);
  return entries.map((entry) => ({
    params: { slug: cleanSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Post data={entry.data} collection="posts" body={entry.body}>
  <Content />
</Post>
