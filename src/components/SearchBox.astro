---
/**
 * SearchBox.astro — the Pagefind full-text search box.
 *
 * Used on the home page, the Library, and the dedicated /search page.
 * Search only works on the BUILT site: the postbuild step indexes dist/ into
 * /pagefind/, so `astro dev` shows an empty box.
 *
 * Two things this component gets right that a bare <div id="search"> did not:
 *  - It reserves the box's height (.lib-search has min-height in global.css), so
 *    Pagefind injecting the input after load does not shove content down (CLS).
 *  - It names the generated input (autofill/a11y: a form field needs an id/name).
 */
---
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<div id="search" class="lib-search"></div>
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    new PagefindUI({ element: '#search', showSubResults: true });
    // Pagefind builds the input synchronously; name it on the next frame so the
    // generated form field is not flagged as missing an id/name.
    requestAnimationFrame(() => {
      const input = document.querySelector('#search input.pagefind-ui__search-input');
      if (input && !input.getAttribute('name')) input.setAttribute('name', 'q');
    });
  });
</script>
