---
// Single source of truth for the applied-musings note.
// Rendered by Post.astro whenever collection === 'applied-musings'.
interface Props {
  companionSlug?: string;
}
const { companionSlug } = Astro.props;
---
<p class="applied-disclaimer">
  An <strong>applied musing</strong> &ndash; written for a general audience.{' '}
  {
    companionSlug && (
      <span>
        Read the <a href={`/posts/${companionSlug}/`}>longer companion piece</a>.
      </span>
    )
  }
</p>
